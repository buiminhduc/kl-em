# Postgres from docker-compose.yml (host port 5433 to avoid clashing with a local Postgres on 5432)
DATABASE_URL=postgres://scheduler:scheduler@localhost:5433/scheduler
# Integration tests use a separate database on the same server; it is created and migrated by the test setup
TEST_DATABASE_URL=postgres://scheduler:scheduler@localhost:5433/scheduler_test
# 3100 to avoid clashing with common dev ports 3000-3006
PORT=3100
LOG_LEVEL=info
# Swagger UI at /docs. Defaults to true, or false when NODE_ENV=production.
# SWAGGER_ENABLED=true
# docker compose only: Postgres password for the compose stack (default: scheduler). If you set it,
# use the same password in DATABASE_URL / TEST_DATABASE_URL above.
# POSTGRES_PASSWORD=scheduler
